---
import Icon from '../Icon.astro';
import Section from '../Section.astro';

const items = [
  {
    icon: 'layers',
    name: 'Void SDK',
    en: 'Server + Client in one build',
    desc: '通过基于文件的 API 路由、服务端渲染页面，以及面向数据库、存储与 AI 的类型化 API，把服务端与客户端的代码一同构建。类型从数据库查询一路贯穿到 UI。',
    points: [
      '服务端路由与页面 loader',
      'Drizzle schema → 处理器 → 客户端',
      'KV / R2 / 队列 / AI 类型化 API',
    ],
    href: '/docs/type-safety',
  },
  {
    icon: 'terminal',
    name: 'Void CLI',
    en: 'Build · provision · migrate · deploy',
    desc: '构建应用、开通它所使用的 Cloudflare 资源、执行迁移，并用一条命令完成部署。通过同一个 CLI 管理资源、查看日志以及回滚。',
    points: [
      'void init / deploy / connect',
      'void db generate · migrate · seed',
      'void project status · logs · rollback',
    ],
    href: '/docs/deployment',
  },
  {
    icon: 'globe',
    name: 'Void Platform',
    en: 'A shared deployment home',
    desc: '在你的 Cloudflare 账户中安装一套共享的部署环境，供团队或客户使用，具备访问控制、资源限额与用量统计，以及关联应用的授权部署。',
    points: ['团队共享的部署环境', '访问控制与资源配额', '保留的部署历史与回滚'],
    href: '/docs/platform',
  },
];
---

<Section
  id="toolchain"
  eyebrow="三件套"
  title="为**你和你的编程智能体**准备"
  lead="SDK、CLI 与平台各自独立，也可以组合使用：从本地开发到团队规模化部署，都由同一套工具覆盖。"
>
  <div class="mt-14 border-t" style="border-color:var(--c-line)">
    {
      items.map((item, i) => (
        <a
          href={item.href}
          class="reveal group relative grid gap-x-8 gap-y-5 border-b py-8 transition-colors hover:bg-[color-mix(in_oklab,var(--c-fg)_3%,transparent)] lg:grid-cols-[6.5rem_minmax(0,1fr)_minmax(0,1.1fr)] lg:py-10"
          style={`border-color:var(--c-line);--reveal-i:${i}`}
        >
          <span
            class="pointer-events-none absolute top-0 bottom-0 left-0 w-px origin-top scale-y-0 transition-transform duration-500 group-hover:scale-y-100"
            style="background:var(--c-accent)"
            aria-hidden="true"
          />

          <div class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-4 lg:pl-3">
            <span
              class="font-display text-[1.5rem] leading-none font-semibold tabular-nums"
              style="color:var(--c-fg-subtle)"
            >
              0{i + 1}
            </span>
            <span
              class="grid size-10 place-items-center rounded-lg border transition-colors group-hover:border-[color:var(--c-accent)]"
              style="border-color:var(--c-line);background:var(--c-surface-2);color:var(--c-accent)"
            >
              <Icon name={item.icon as never} class="size-[1.15rem]" />
            </span>
          </div>

          <div class="lg:pl-3">
            <h3
              class="font-display text-[1.5rem] font-semibold tracking-[-0.03em]"
              style="color:var(--c-fg)"
            >
              {item.name}
            </h3>
            <p class="mt-1.5 font-mono text-[0.75rem]" style="color:var(--c-fg-subtle)">
              {item.en}
            </p>
          </div>

          <div class="lg:pl-3">
            <p class="text-[0.93rem] leading-[1.8]" style="color:var(--c-fg-muted)">
              {item.desc}
            </p>
            <ul class="mt-5 space-y-2">
              {item.points.map((p) => (
                <li class="flex items-start gap-2 text-[0.85rem]" style="color:var(--c-fg-muted)">
                  <span
                    class="mt-[0.55em] size-1 shrink-0 rounded-full"
                    style="background:var(--c-accent)"
                    aria-hidden="true"
                  />
                  {p}
                </li>
              ))}
            </ul>
            <span
              class="mt-5 inline-flex items-center gap-1.5 text-[0.85rem] font-medium"
              style="color:var(--c-fg)"
            >
              了解详情
              <Icon
                name="arrowRight"
                class="size-3.5 transition-transform duration-300 group-hover:translate-x-1"
              />
            </span>
          </div>
        </a>
      ))
    }
  </div>
</Section>
