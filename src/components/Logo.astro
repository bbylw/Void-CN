---
interface Props {
  class?: string;
  /** 显示中文后缀「中文文档」 */
  suffix?: boolean;
  markOnly?: boolean;
}
const { class: className = '', suffix = false, markOnly = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <span class="relative inline-flex items-baseline">
    <span class="font-semibold tracking-[-0.055em]" style="font-size:1.32em;line-height:1"
      >Void</span
    >
    <span
      class="ml-[0.06em] inline-block size-[0.19em] translate-y-[-0.02em] rounded-full bg-current"
      aria-hidden="true"></span>
  </span>
  {
    !markOnly && suffix && (
      <span
        class="rounded-full border px-1.5 py-0.5 font-mono text-[0.58rem] leading-none font-medium tracking-[0.14em] uppercase"
        style="border-color:var(--c-line-strong);color:var(--c-fg-subtle)"
      >
        中文
      </span>
    )
  }
</span>
