---
interface Props {
  class?: string;
  markOnly?: boolean;
}
const { class: className = '', markOnly = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <span class="relative inline-flex items-baseline">
    <span class="font-semibold tracking-[-0.055em]" style="font-size:1.32em;line-height:1"
      >Void</span
    >
    <span
      class="ml-[0.06em] inline-block size-[0.19em] translate-y-[-0.02em] rounded-full bg-current"
      aria-hidden="true"></span>
  </span>
</span>
