---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2 font-display', className]}>
  <span class="relative inline-flex items-baseline">
    <span class="font-semibold tracking-[-0.05em]" style="font-size:1.32em;line-height:1">Void</span
    >
    <span
      class="ml-[0.09em] inline-block size-[0.2em] translate-y-[-0.02em] rounded-[2px]"
      style="background:var(--c-accent)"
      aria-hidden="true"></span>
  </span>
</span>
