---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import SearchTrigger from './SearchTrigger.astro';
import ThemeToggle from './ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';
import { HOME_NAV, SITE } from '../data/site';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href.split('#')[0]!);
---

<header
  class="glass sticky top-0 z-50 border-b"
  style="border-color:var(--c-line)"
  data-site-header
>
  <div class="mx-auto flex h-16 max-w-[88rem] items-center gap-4 px-4 sm:px-6 lg:px-10">
    <a href="/" class="group flex shrink-0 items-center" aria-label="Void 首页">
      <Logo class="text-[1.05rem] transition-opacity group-hover:opacity-70" />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        HOME_NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative rounded-lg px-3 py-2 text-[0.83rem] font-medium transition-colors',
              isActive(item.href)
                ? ''
                : 'hover:bg-[color-mix(in_oklab,var(--c-fg)_6%,transparent)]',
            ]}
            style={{ color: isActive(item.href) ? 'var(--c-fg)' : 'var(--c-fg-muted)' }}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.title}
            {isActive(item.href) && (
              <span
                class="absolute inset-x-3 -bottom-px h-px"
                style="background:linear-gradient(90deg,transparent,var(--c-violet),transparent)"
                aria-hidden="true"
              />
            )}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <div class="hidden w-56 lg:block xl:w-64">
        <SearchTrigger />
      </div>

      <ThemeToggle />

      <a
        href={SITE.repo}
        target="_blank"
        rel="noreferrer noopener"
        class="hidden size-9 place-items-center rounded-lg border transition-colors hover:bg-[color-mix(in_oklab,var(--c-fg)_7%,transparent)] sm:grid"
        style="border-color:var(--c-line);color:var(--c-fg-muted)"
        aria-label="在 GitHub 上查看 voidzero-dev/void"
        title="GitHub"
      >
        <svg viewBox="0 0 16 16" fill="currentColor" class="size-[1.05rem]" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>

      <a href="/docs/quickstart" class="btn btn-primary hidden sm:inline-flex">
        开始构建
        <Icon name="arrowRight" class="size-3.5" />
      </a>

      <MobileMenu links={HOME_NAV} />
    </div>
  </div>
</header>

<style>
  /* 滚动时收紧头部，形成一条细边 */
  header[data-site-header] {
    transition: box-shadow 0.3s ease;
  }
  header[data-site-header][data-scrolled] {
    box-shadow:
      0 1px 0 0 var(--c-line),
      0 12px 32px -24px rgb(0 0 0 / 0.55);
  }
</style>

<script>
  import '../scripts/search-launcher';

  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
