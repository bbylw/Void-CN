---
import Icon from '../Icon.astro';
import { DOCS_NAV } from '../../data/site';

interface Props {
  currentPath: string;
  compact?: boolean;
}
const { currentPath, compact = false } = Astro.props;
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const current = norm(currentPath);
---

{compact ? (
  // compact = 移动端目录抽屉里的实例：不做滚动位置恢复（抽屉每次打开都从头看）
  <ul data-docs-sidebar="compact" class="space-y-1">
    {DOCS_NAV.map((g) => (
      <li>
        <p
          class="px-2 pt-2 pb-1 font-mono text-[0.62rem] tracking-[0.16em] uppercase"
          style="color:var(--c-fg-subtle)"
        >
          {g.label}
        </p>
        <ul class="space-y-0.5">
          {g.items.map((i) => {
            const active = norm(i.href) === current;
            return (
              <li>
                <a
                  href={i.href}
                  aria-current={active ? 'page' : undefined}
                  class="block rounded-md px-2 py-1 text-[0.82rem] transition-colors"
                  style={{
                    color: active ? 'var(--c-fg)' : 'var(--c-fg-muted)',
                    background: active
                      ? 'color-mix(in oklab, var(--c-accent) 12%, transparent)'
                      : 'transparent',
                  }}
                >
                  {i.title}
                </a>
              </li>
            );
          })}
        </ul>
      </li>
    ))}
  </ul>
) : (
  <nav aria-label="文档导航" data-docs-sidebar="" class="pb-4">
    {DOCS_NAV.map((g) => (
      <div class="mb-5">
        <h2 class="eyebrow px-2 pb-1.5">{g.label}</h2>
        <ul class="space-y-0.5">
          {g.items.map((i) => {
            const active = norm(i.href) === current;
            return (
              <li>
                <a
                  href={i.href}
                  aria-current={active ? 'page' : undefined}
                  class="group relative flex items-center rounded-md py-[0.3rem] pr-2 pl-2.5 text-[0.845rem] transition-colors"
                  style={{ color: active ? 'var(--c-fg)' : 'var(--c-fg-muted)' }}
                >
                  <span
                    class="absolute inset-y-1 left-0 w-[2px] rounded-full transition-all duration-300"
                    style={{
                      background: active ? 'var(--c-accent)' : 'transparent',
                      opacity: active ? '1' : '0',
                    }}
                  />
                  <span
                    class="transition-colors group-hover:text-[color:var(--c-fg)]"
                    style={{ fontWeight: active ? '600' : '400' }}
                  >
                    {i.title}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}

    <div class="mt-6 border-t pt-4" style="border-color:var(--c-line)">
      <a
        href="https://github.com/voidzero-dev/void"
        target="_blank"
        rel="noreferrer noopener"
        class="flex items-center gap-2 rounded-md px-2 py-1.5 text-[0.8rem] transition-colors"
        style="color:var(--c-fg-muted)"
      >
        <Icon name="link" class="size-3.5" />
        英文原站
        <Icon name="arrowUpRight" class="ml-auto size-3 opacity-50" />
      </a>
    </div>
  </nav>
)}

<script>
  /**
   * 侧边栏（112 项长导航）滚动位置：
   * 1) 翻页后恢复上一页的滚动位置 —— 视线接着上一页，不必从头再找；
   * 2) 恢复后若当前项仍不在可视区，再微调容器 scrollTop；
   * 3) 全程只动滚动容器，不动整页（scrollIntoView 会沿祖先滚动链把正文也拉走）。
   */
  const SCROLL_KEY = 'void-docs-sidebar-scroll';

  const initSidebarScroll = () => {
    document.querySelectorAll<HTMLElement>('[data-docs-sidebar]').forEach((nav) => {
      if (nav.dataset.docsSidebar === 'compact') return;
      // astro:page-load 重复触发时只初始化一次，避免叠加 scroll 监听
      if (nav.dataset.scrollReady) return;
      nav.dataset.scrollReady = '1';

      const scroller = nav.closest<HTMLElement>('[data-docs-scroller]');
      // 找不到滚动容器，或桌面侧边栏当前不显示（窄屏 display:none → offsetParent 为 null）时跳过：
      // 否则会把 0 写回 sessionStorage，覆盖掉桌面端记下的位置。
      if (!scroller || scroller.offsetParent === null) return;

      try {
        const saved = sessionStorage.getItem(SCROLL_KEY);
        if (saved !== null) scroller.scrollTop = Number(saved) || 0;
      } catch {}

      const active = nav.querySelector<HTMLElement>('[aria-current="page"]');
      if (active) {
        const box = scroller.getBoundingClientRect();
        const item = active.getBoundingClientRect();
        const pad = 24;
        if (item.top < box.top + pad) {
          scroller.scrollTop -= box.top + pad - item.top;
        } else if (item.bottom > box.bottom - pad) {
          scroller.scrollTop += item.bottom - (box.bottom - pad);
        }
      }

      let queued = false;
      scroller.addEventListener(
        'scroll',
        () => {
          // rAF 合帧：滚动中每帧最多写一次 sessionStorage，且只读 scrollTop（不触发布局）
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            try {
              sessionStorage.setItem(SCROLL_KEY, String(scroller.scrollTop));
            } catch {}
          });
        },
        { passive: true },
      );
    });
  };

  initSidebarScroll();
  document.addEventListener('astro:page-load', initSidebarScroll);
</script>
