---
import Icon from '../Icon.astro';

interface Props {
  type?: 'info' | 'tip' | 'warn' | 'danger';
  title?: string;
}
const { type = 'info', title } = Astro.props;

const MAP = {
  info: { icon: 'sparkle', label: '说明', color: 'var(--c-cyan)' },
  tip: { icon: 'bolt', label: '提示', color: 'var(--c-violet)' },
  warn: { icon: 'shield', label: '注意', color: 'var(--c-amber)' },
  danger: { icon: 'close', label: '警告', color: 'var(--c-red)' },
} as const;

const conf = MAP[type];
---

<aside
  class="my-6 flex gap-3 rounded-[var(--radius-card)] border p-4"
  style={{
    borderColor: `color-mix(in oklab, ${conf.color} 32%, transparent)`,
    background: `color-mix(in oklab, ${conf.color} 7%, transparent)`,
  }}
>
  <span class="mt-0.5 shrink-0" style={`color:${conf.color}`}>
    <Icon name={conf.icon} class="size-4" />
  </span>
  <div class="min-w-0 text-[0.9rem] leading-[1.75] [&>*+*]:mt-3">
    <p class="font-semibold" style="color:var(--c-fg)">
      {title ?? conf.label}
    </p>
    <div class="[&_code]:text-[0.82em]" style="color:var(--c-fg-muted)">
      <slot />
    </div>
  </div>
</aside>
