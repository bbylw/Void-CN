---
interface Props {
  cols?: 2 | 3 | 4;
  title?: string;
}
const { cols = 2, title } = Astro.props;
---

<section class="my-8">
  {title && <h2 class="!mt-0 !border-0 !pt-0 text-[1.15rem] font-semibold">{title}</h2>}
  <div
    class:list={[
      'grid gap-3',
      cols === 2
        ? 'sm:grid-cols-2'
        : cols === 3
          ? 'sm:grid-cols-2 lg:grid-cols-3'
          : 'sm:grid-cols-2 lg:grid-cols-4',
    ]}
  >
    <slot />
  </div>
</section>
