---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  nested?: boolean;
}
const { headings, nested = false } = Astro.props;
---

{
  headings.length > 0 ? (
    <nav aria-label="本页目录" data-toc={nested ? 'nested' : undefined} class="pb-10">
      <p class="eyebrow mb-3 px-3">本页目录</p>
      <ul class="relative space-y-0.5 border-l" style="border-color:var(--c-line)">
        {headings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="block border-l-2 py-[0.28rem] text-[0.8rem] leading-snug transition-all duration-200"
              style={{
                marginLeft: '-1px',
                paddingLeft: h.depth === 3 ? '1.6rem' : '0.75rem',
                borderColor: 'transparent',
                color: 'var(--c-fg-subtle)',
              }}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : (
    <p class="px-3 pb-10 text-[0.8rem]" style="color:var(--c-fg-subtle)">
      本页暂无小节
    </p>
  )
}

<script>
  const initToc = () => {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (!links.length) return;

    const bySlug = new Map(links.map((l) => [l.dataset.tocLink!, l]));
    const targets = links
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => Boolean(el));

    let currentId = '';
    const paint = () => {
      for (const [slug, link] of bySlug) {
        const on = slug === currentId;
        link.style.color = on ? 'var(--c-violet)' : 'var(--c-fg-subtle)';
        link.style.borderColor = on ? 'var(--c-violet)' : 'transparent';
        link.style.fontWeight = on ? '560' : '400';
      }
    };

    const onScroll = () => {
      let active = '';
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= 140) active = t.id;
      }
      if (active !== currentId) {
        currentId = active;
        paint();
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  };

  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
