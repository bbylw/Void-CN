---
/**
 * 移动端抽屉导航（零 JS 框架）。
 * 抽屉常驻 DOM，用 hidden 属性切换；打开时锁定背景滚动，Esc 或点击链接关闭。
 */
import SearchTrigger from './SearchTrigger.astro';
import { HOME_NAV } from '../data/site';
---

<button
  type="button"
  data-menu-open
  aria-label="打开菜单"
  class="grid size-9 place-items-center rounded-lg border md:hidden"
  style="border-color:var(--c-line);color:var(--c-fg-muted)"
>
  <svg
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width={1.7}
    stroke-linecap="round"
    class="size-4"
    aria-hidden="true"
  >
    <path d="M3.5 6h13M3.5 10h13M3.5 14h13"></path>
  </svg>
</button>

<div
  data-menu-drawer
  hidden
  class="fixed inset-0 z-[90] md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="导航菜单"
>
  <button
    data-menu-backdrop
    class="absolute inset-0 cursor-default"
    style="background:color-mix(in oklab, var(--c-bg-sunken) 80%, transparent);backdrop-filter:blur(4px)"
    aria-label="关闭菜单"
    tabindex="-1"
  >
  </button>
  <div
    class="absolute inset-x-0 top-0 flex flex-col gap-5 rounded-b-[var(--radius-panel)] border-b p-5 pb-7"
    style="background:var(--c-bg);border-color:var(--c-line)"
  >
    <div class="flex items-center justify-between">
      <span class="eyebrow">导航</span>
      <button
        type="button"
        data-menu-close
        aria-label="关闭菜单"
        class="grid size-9 place-items-center rounded-lg border"
        style="border-color:var(--c-line);color:var(--c-fg-muted)"
      >
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width={1.7}
          stroke-linecap="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="m5 5 10 10M15 5 5 15"></path>
        </svg>
      </button>
    </div>

    <div class="lg:hidden">
      <SearchTrigger />
    </div>

    <nav class="flex flex-col" aria-label="移动端导航">
      {
        HOME_NAV.map((l, i) => (
          <a
            href={l.href}
            data-menu-link
            class="flex items-baseline gap-3 border-b py-3.5 text-[1.05rem] font-medium"
            style="border-color:var(--c-line);color:var(--c-fg)"
          >
            <span class="font-mono text-[0.68rem]" style="color:var(--c-fg-subtle)">
              {String(i + 1).padStart(2, '0')}
            </span>
            {l.title}
          </a>
        ))
      }
    </nav>

    <a href="/docs/quickstart" data-menu-link class="btn btn-primary mt-1 w-full"> 快速开始 </a>
  </div>
</div>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const drawer = document.querySelector<HTMLElement>('[data-menu-drawer]');
  if (openBtn && drawer) {
    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        drawer.querySelector<HTMLButtonElement>('[data-menu-close]')?.focus();
      } else {
        openBtn.focus();
      }
    };
    openBtn.addEventListener('click', () => setOpen(true));
    drawer.querySelector('[data-menu-backdrop]')?.addEventListener('click', () => setOpen(false));
    drawer.querySelector('[data-menu-close]')?.addEventListener('click', () => setOpen(false));
    drawer
      .querySelectorAll('[data-menu-link]')
      .forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) setOpen(false);
    });
  }
</script>
