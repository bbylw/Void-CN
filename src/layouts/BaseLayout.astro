---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** og:type */
  type?: 'website' | 'article';
  noindex?: boolean;
  class?: string;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  noindex = false,
  class: bodyClass = '',
} = Astro.props;

const pageTitle = title
  ? `${title} · ${SITE.name} 中文文档`
  : `${SITE.name} — Cloudflare Workers 上的全栈框架`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://void-cn.pages.dev');
const ogImage = new URL('/og.png', Astro.site ?? 'https://void-cn.pages.dev').href;
---

<!doctype html>
<html lang="zh-CN" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Void" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0b0b0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f4f2" media="(prefers-color-scheme: light)" />

    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Void 中文文档" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" hreflang="zh-CN" href={canonical.href} />
    <link rel="alternate" hreflang="x-default" href={canonical.href} />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('void-theme');
          const dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch {}
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-dvh overflow-x-clip antialiased" class:list={[bodyClass]}>
    <a
      href="#main"
      class="sr-only rounded-md px-4 py-2 focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200]"
      style="background:var(--c-surface);border:1px solid var(--c-line-strong)">跳到主要内容</a
    >
    <slot />

    <script>
      // 代码块与表格增强（模块首次执行时自初始化，并在 astro:page-load 时重跑）
      import '../scripts/code-blocks';
      // 滚动入场动效
      import '../scripts/reveal';
    </script>
  </body>
</html>
