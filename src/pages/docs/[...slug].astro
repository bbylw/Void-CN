---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DOCS_NAV } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => {
    const slug = entry.id === 'index' ? '' : entry.id;
    return { params: { slug: slug || undefined }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

/** 按侧边栏顺序展平，用于上一页 / 下一页 */
const flat = DOCS_NAV.flatMap((g) => g.items);
const currentHref = entry.id === 'index' ? '/docs' : `/docs/${entry.id}`;
const idx = flat.findIndex((i) => i.href.replace(/\/$/, '') === currentHref);
const prev = idx > 0 ? flat[idx - 1] : undefined;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : undefined;

/** 中文字符按 350 字/分钟估算，英文按 220 词/分钟 */
const raw = entry.body ?? '';
const cjk = (raw.match(/[一-龥]/g) ?? []).length;
const words = raw
  .replace(/[一-龥]/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const minutes = Math.max(1, Math.round(cjk / 350 + words / 220));
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  badge={entry.data.badge}
  headings={headings}
  prev={prev}
  next={next}
  readingTime={`${minutes} 分钟`}
>
  <Content />
</DocsLayout>
